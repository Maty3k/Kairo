#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# tools/mac/pc: drive Kairo's Windows dev PC from the Mac over SSH (docs/PLAN.md section 3.1, M0).
# Run "tools/mac/pc help" for the verbs. Contact: https://github.com/Maty3k/Kairo
#
# House rules (CLAUDE.md; docs/PLAN.md Appendix A): run "pc status" first. BUSY means the owner
# may be playing, so work on the Mac. Every verb except status, doctor and ssh checks the busy
# state on the PC itself and refuses unless --force, which needs the owner's OK in this session.
# harness capture's two read-only steps (harness-pre and harness-events) never refuse: they
# change nothing, and the reset check must run whatever the owner is doing.
#
# How it works: a remote verb pipes "prelude + tools/mac/remote/lib.ps1 + <verb>.ps1" over ssh
# into '"C:\Program Files\PowerShell\7\pwsh.exe" -NoProfile -NonInteractive ... -EncodedCommand
# <stub.ps1 as Base64>'. The PC's SSH shell is cmd.exe /d /c (tools/pc/bootstrap.ps1), which runs
# that line as plain text: only the quoted pwsh path and Base64 reach it, so nothing is re-parsed
# by bash, ssh or cmd, and no profile or AutoRun runs in the elevated session.
# Arguments travel inside the script as PowerShell literals that are validated here first, so an
# id or a path cannot inject commands. The script's last "@@KAIRO-EXIT <n>" line carries the exit
# code back. Git for "pc sync" goes through the same encoding (see git_ssh_transport).
#
# Written for macOS's /bin/bash 3.2: no associative arrays, mapfile, ${var,,} or ;& in case.

set -u
set -o pipefail
export LC_ALL=C

PC_HOST=${KAIRO_PC:-kairo-pc}
DEFAULT_PC_PWSH='C:\Program Files\PowerShell\7\pwsh.exe'   # the MSI's path (tools/pc/bootstrap.ps1)
PC_PWSH=${KAIRO_PC_PWSH:-$DEFAULT_PC_PWSH}
KEY_FILE=${KAIRO_PC_KEY:-$HOME/.ssh/kairo_pc}
SSH=/usr/bin/ssh                # Apple's OpenSSH and its ssh-agent
SCP=/usr/bin/scp
PC_SRC_GIT='C:/kairo/src'       # the clone, as git and scp spell it
# TODO(verify): Win32-OpenSSH's SFTP server takes C:/... as an absolute path (its realpath() does).
PC_BUNDLE_SCP='C:/kairo/src/.git/kairo-sync.bundle'
PC_BUNDLE_WIN='C:\kairo\src\.git\kairo-sync.bundle'
MAX_UNTRACKED_BYTES=$((50 * 1024 * 1024))
TMP_BASE=${TMPDIR:-/tmp}
TMP_BASE=${TMP_BASE%/}
NL='
'

SELF_DIR=$(cd "$(dirname "$0")" && pwd -P) || exit 1
SELF="$SELF_DIR/$(basename "$0")"
REMOTE_DIR="$SELF_DIR/remote"
JOBS_DIR="$SELF_DIR/jobs"
REPO_ROOT=$(cd "$SELF_DIR/../.." && pwd -P) || exit 1

# Command-line options win over every ~/.ssh/config entry, so an earlier "Host *" block with
# StrictHostKeyChecking no or accept-new cannot make pc trust an unknown or changed host key.
SSH_OPTS=(-T -a -x -o BatchMode=yes -o StrictHostKeyChecking=yes -o IdentitiesOnly=yes -i "$KEY_FILE"
    -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=4)
SCP_OPTS=(-q -o BatchMode=yes -o StrictHostKeyChecking=yes -o IdentitiesOnly=yes -i "$KEY_FILE" -o ConnectTimeout=10)
MAX_REMOTE_COMMAND=8000   # cmd.exe takes at most 8191 characters per command line

# ------------------------------------------------------------------------------------------
# Small helpers
# ------------------------------------------------------------------------------------------
say() { printf '%s\n' "$*"; }
err() { printf 'pc: %s\n' "$*" >&2; }
die() {
    err "$1"
    exit "${2:-1}"
}
usage_error() {
    err "$1"
    err "see: tools/mac/pc help"
    exit 2
}

TEMP_PATHS=''
# shellcheck disable=SC2317,SC2329 # called by the EXIT trap below
cleanup() {
    local path
    local IFS="$NL"
    for path in $TEMP_PATHS; do
        [ -n "$path" ] && rm -rf "$path"
    done
}
trap cleanup EXIT
make_temp() { # make_temp file|dir -> prints the new path; the caller must register_temp it (this runs in a subshell)
    local path
    if [ "$1" = dir ]; then
        path=$(mktemp -d "$TMP_BASE/kairo-pc.XXXXXX") || return 1
    else
        path=$(mktemp "$TMP_BASE/kairo-pc.XXXXXX") || return 1
    fi
    printf '%s\n' "$path"
}
register_temp() { TEMP_PATHS="$TEMP_PATHS$1$NL"; }

is_uint() { # whole number with at most 6 digits
    case "$1" in '' | *[!0-9]*) return 1 ;; esac
    [ "${#1}" -le 6 ]
}
is_job_id() { # ^[A-Za-z0-9_-]{1,64}$ (crates/kairo-core/src/job.rs)
    case "$1" in '' | *[!A-Za-z0-9_-]*) return 1 ;; esac
    [ "${#1}" -le 64 ]
}
is_build_id() { # <yyyyMMdd>-<HHmmss>-<7 to 40 lowercase hex digits>
    case "$1" in
    [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]-*) ;;
    *) return 1 ;;
    esac
    local hex=${1:16}
    case "$hex" in '' | *[!0-9a-f]*) return 1 ;; esac
    [ "${#hex}" -ge 7 ] && [ "${#hex}" -le 40 ]
}
is_package() { # a cargo package name
    case "$1" in '' | -* | *[!A-Za-z0-9_-]*) return 1 ;; esac
    [ "${#1}" -le 64 ]
}
is_alias() { # a monitor alias: ^[a-z0-9][a-z0-9_-]{0,31}$ (byte ranges: LC_ALL=C above)
    case "$1" in '' | [!a-z0-9]* | *[!a-z0-9_-]*) return 1 ;; esac
    [ "${#1}" -le 32 ]
}

is_pipe_name() { # NAME or \\.\pipe\NAME with NAME in [A-Za-z0-9._-]{1,200} (kairo-core hello.rs)
    local name=$1
    # shellcheck disable=SC1003 # the backslashes are literal: '\\.\pipe\'
    case "$name" in '\\.\pipe\'*) name=${name#'\\.\pipe\'} ;; esac
    case "$name" in '' | *[!A-Za-z0-9._-]*) return 1 ;; esac
    [ "${#name}" -le 200 ]
}
need_value() { # need_value <option> <number of remaining args>
    [ "$2" -ge 2 ] || usage_error "$1 needs a value"
}

# Sanity checks on the configuration itself.
case "$PC_HOST" in '' | -* | *[!A-Za-z0-9._@-]*) die "KAIRO_PC must be an ssh host alias such as kairo-pc" 2 ;; esac
# It is quoted on the PC's cmd.exe command line, so it may hold spaces but none of " % ^ & | < > !
case "$PC_PWSH" in '' | -* | *[!A-Za-z0-9._:\\/\ -]*) die "KAIRO_PC_PWSH must be the path of pwsh.exe (letters, digits, spaces, . _ : \\ / -)" 2 ;; esac
case "$SELF" in *"'"* | *[![:print:]]*) die "the path of this script must not contain quotes or unusual characters: $SELF" 2 ;; esac

# ------------------------------------------------------------------------------------------
# Running PowerShell on the PC
# ------------------------------------------------------------------------------------------
ps_encode() { # stdin: PowerShell source -> stdout: Base64 of UTF-16LE, without comment lines
    grep -v '^[[:space:]]*#' | /usr/bin/iconv -f UTF-8 -t UTF-16LE | /usr/bin/base64 | tr -d '\n'
}
# TODO(verify) in M0: sshd runs '"cmd.exe" /d /c "<this line>"' (Win32-OpenSSH w32-doexec.c), and
# cmd hands pwsh the inherited stdin and stdout unchanged (and, for sync, git too). This follows
# from the Win32-OpenSSH source and cmd's documented quote rule (more than two quotes: the outer
# pair is stripped), but has not run on the PC yet.
# TODO(verify): Microsoft Defender does not object to "pwsh -EncodedCommand" started by sshd.
remote_command() { # the command line the PC's SSH shell (cmd.exe /d /c) runs; fails if too long
    local line
    line=$(printf '"%s" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -OutputFormat Text -EncodedCommand %s' "$PC_PWSH" "$1")
    if [ "${#line}" -gt "$MAX_REMOTE_COMMAND" ]; then
        err "internal: the remote command has ${#line} characters; cmd.exe takes at most 8191"
        return 1
    fi
    printf '%s' "$line"
}

ensure_agent_key() {
    # Load the key into ssh-agent, so BatchMode ssh never needs to ask for its passphrase:
    # tools/mac/keychain-askpass answers ssh-add once from the Keychain item that
    # tools/mac/ssh-setup.sh made.
    [ -f "$KEY_FILE" ] && [ -f "$KEY_FILE.pub" ] || return 0
    local fingerprint loaded stamp
    fingerprint=$(/usr/bin/ssh-keygen -lf "$KEY_FILE.pub" 2>/dev/null | awk '{print $2}')
    [ -n "$fingerprint" ] || return 0
    loaded=$(/usr/bin/ssh-add -l 2>/dev/null)
    case "$loaded" in *"$fingerprint"*) return 0 ;; esac
    stamp=$(mktemp "$TMP_BASE/kairo-askpass.XXXXXX") || return 0
    if ! KAIRO_PC_KEY="$KEY_FILE" KAIRO_ASKPASS_STAMP="$stamp" SSH_ASKPASS="$SELF_DIR/keychain-askpass" \
        SSH_ASKPASS_REQUIRE=force /usr/bin/ssh-add -q "$KEY_FILE" </dev/null >/dev/null 2>&1; then
        err "note: could not load $KEY_FILE into ssh-agent with its passphrase from the Keychain (is the login Keychain unlocked?); tools/mac/ssh-setup.sh retries"
    fi
    rm -f "$stamp"
}

ssh_failed_hint() {
    err "ssh could not reach '$PC_HOST' (exit 255). Check that the PC is on and on the same network."
    err "First connection? Pin the PC's host key: tools/mac/ssh-setup.sh <pc-ip> <windows-user> <SHA256:fingerprint>,"
    err "with the 'Host key' line of the bootstrap's DONE screen (--trust-on-first-use only if that line is missing)"
}

PRELUDE=''
pre_reset() { PRELUDE="\$Pc = @{}$NL"; }
pre_safe() { # values become PowerShell single-quoted literals: printable ASCII, no quote
    case "$1" in *"'"* | *[![:print:]]*) return 1 ;; esac
    return 0
}
pre_str() {
    pre_safe "$2" || die "internal: unsafe value for $1"
    PRELUDE="$PRELUDE\$Pc['$1'] = '$2'$NL"
}
pre_int() {
    is_uint "$2" || die "internal: $1 must be a whole number"
    PRELUDE="$PRELUDE\$Pc['$1'] = $2$NL"
}
pre_bool() {
    if [ "$2" = 1 ]; then
        PRELUDE="$PRELUDE\$Pc['$1'] = \$true$NL"
    else
        PRELUDE="$PRELUDE\$Pc['$1'] = \$false$NL"
    fi
}
pre_list() { # pre_list <name> [values...]
    local name=$1 items='' value
    shift
    for value in "$@"; do
        pre_safe "$value" || die "internal: unsafe value for $name"
        items="$items'$value',"
    done
    PRELUDE="$PRELUDE\$Pc['$name'] = @(${items%,})$NL"
}

KV_FILE=''
run_ps() { # run_ps <verb>: run remote/<verb>.ps1 with $PRELUDE; streams its output; returns its exit code
    local script="$REMOTE_DIR/$1.ps1" encoded command status_file rc ssh_rc
    [ -f "$script" ] || die "missing $script"
    encoded=$(ps_encode <"$REMOTE_DIR/stub.ps1") || die "could not encode $REMOTE_DIR/stub.ps1"
    command=$(remote_command "$encoded") || exit 2
    status_file=$(make_temp file) || die "mktemp failed"
    register_temp "$status_file"
    KV_FILE=$(make_temp file) || die "mktemp failed"
    register_temp "$KV_FILE"
    ensure_agent_key
    {
        printf '%s' "$PRELUDE"
        cat "$REMOTE_DIR/lib.ps1" "$script"
    } | "$SSH" "${SSH_OPTS[@]}" "$PC_HOST" "$command" |
        awk -v status_file="$status_file" -v kv_file="$KV_FILE" '
            BEGIN { code = "" }
            # No escape sequence from the PC (job output, logs) reaches the terminal.
            { sub(/\r$/, ""); gsub(/[[:cntrl:]]/, " ") }
            # The last marker wins: the remote scripts print the real one last, after any
            # untrusted output that might imitate it (lib.ps1 also indents all log lines).
            /^@@KAIRO-EXIT [0-9]+$/ { code = $2; next }
            /^@@KV / { print substr($0, 6) > kv_file; next }
            { print; fflush() }
            END { print code > status_file }'
    ssh_rc=${PIPESTATUS[1]}
    rc=$(cat "$status_file" 2>/dev/null)
    if [ -z "$rc" ]; then
        if [ "$ssh_rc" = 255 ]; then
            ssh_failed_hint
            return 255
        fi
        err "the remote script ended without reporting a result (ssh exit $ssh_rc)"
        err "is PowerShell 7 installed on the PC at '$PC_PWSH'?"
        return 1
    fi
    return "$rc"
}
kv_get() { # value of the last "@@KV key=value" line for this key from the last run_ps
    sed -n "s/^$1=//p" "$KV_FILE" | tail -n 1
}

# Git's ssh program for "pc sync" (git push with GIT_SSH_VARIANT=simple calls "pc <host> <cmd>").
# Instead of letting the PC's shell parse "git-receive-pack 'C:/kairo/src'" (Git for Windows keeps
# git-receive-pack off PATH, and cmd.exe would keep the single quotes), run git's service through
# the same Base64 encoding as everything else.
git_ssh_transport() {
    [ $# -eq 2 ] || {
        err "git transport: expected <host> <command>, got $# arguments"
        return 2
    }
    local host=$1 command=$2 service encoded line
    [ "$host" = "$PC_HOST" ] || {
        err "git transport: unexpected host '$host'"
        return 2
    }
    case "$command" in
    "git-receive-pack '$PC_SRC_GIT'") service=receive-pack ;;
    "git-upload-pack '$PC_SRC_GIT'") service=upload-pack ;;
    *)
        err "git transport: refusing remote command: $command"
        return 2
        ;;
    esac
    encoded=$(sed -e "s|GIT_SERVICE|$service|g" -e "s|GIT_REPO|$PC_SRC_GIT|g" "$REMOTE_DIR/git-service.ps1" | ps_encode) || return 1
    line=$(remote_command "$encoded") || return 1
    ensure_agent_key
    exec "$SSH" "${SSH_OPTS[@]}" "$host" "$line"
}

# ------------------------------------------------------------------------------------------
# Verbs
# ------------------------------------------------------------------------------------------
usage() {
    cat <<'EOF'
usage: tools/mac/pc <verb> [options]

Drives Kairo's Windows dev PC (ssh alias kairo-pc). Run "status" first; BUSY means the owner may be
playing, so work on the Mac. Verbs that do something on the PC refuse when it is busy (exit 3) or
when its state is unknown (exit 4); --force overrides that, only with the owner's OK this session.

  status [--json]          Is the owner at the PC? Reads C:\kairo\state\watch.json; also shows the
                           \Kairo tasks and the current build. Never refuses. Exit 0 IDLE, 3 BUSY,
                           4 UNKNOWN.
  doctor [--local] [--test-presentmon] [--compress]
                           Run tools\pc\doctor.ps1 on the PC (the copy synced to C:\kairo\src;
                           --local sends the Mac's working-tree copy) and print its JSON report.
                           --test-presentmon also proves PresentMon starts unelevated (the doctor
                           skips that while the owner is busy). Never refuses.
  sync [--bundle] [--allow-large] [--force]
                           Send a snapshot of this working tree (index + changes + untracked files
                           that are not ignored) to C:\kairo\src, branch 'snapshot'. Your branches,
                           index and stash are not touched. Uses git push (updateInstead) and falls
                           back to git bundle + scp; --bundle skips the push.
  build [-p PACKAGE]... [--tail N] [--force]
                           cargo build --release (--workspace unless -p) of C:\kairo\src as a hidden,
                           below-normal \Kairo\Run job in the owner's session, never elevated, into
                           C:\kairo\build\target; stops if the owner becomes active (unless --force).
  deploy [--force]         Copy the last successful build to C:\kairo\bin\<build-id>, point
                           C:\kairo\bin\current at it, restart the watch agent, keep 3 builds.
  rollback [BUILD-ID] [--force]
                           Point C:\kairo\bin\current at the previous (or the named) build.
  run JOB [--no-wait | --wait SECONDS] [--tail N] [--force]
                           JOB is a job file or a preset in tools/mac/jobs (e.g. hello). Writes
                           C:\kairo\jobs\next.json, starts \Kairo\Run, waits for the result
                           (default: max_seconds + 30 s) and prints it with the job's output.
  logs [ID] [--tail N] [--force]
                           List the newest job and build results, or show one id's result and logs.
  harness displays [--alias NAME=DISPLAYn]... [--force]
                           Run "kairo-harness displays" as a hidden job and keep its displays.json
                           (every display's device path, GDI and model names, size, refresh, HDR
                           state and mirroring, and every adapter's LUID, PCI ids and model name)
                           in .dogfood/pc/. Aliases such as 180hz and oled map to device paths in
                           .dogfood/pc/monitors.json: --alias names a display by the GDI name in
                           the last table, which must still be the same display; aliases whose
                           display is off are kept.
  harness capture [--monitor ALIAS] [--seconds N | --smoke] [--testbed-fps N] [--capture gfxcapture|ddagrab]
                  [--capture-rate 90] [--output 1080p60|1440p60] [--loglevel debug|verbose]
                  [--finishing] [--voice] [--fetch-clip] [--force]
                           Gate 2: one hidden job runs "kairo-harness run" on monitor ALIAS
                           (default 180hz; never the OLED), recording the testbed with FFmpeg into
                           AMF for N s (default 30; --smoke: 10 s, profile smoke) and judging it
                           with kairo-verify. Refuses over a fullscreen window even with --force.
                           Prints the verdict, failing checks, read-back counts and start-to-report
                           time; keeps the job and reports in .dogfood/ (and the clip with
                           --fetch-clip). Then checks the System log for display-driver resets.
  harness events           Run the reset check a capture left pending. Never refuses.
  cli ping|keys [--pipe NAME] [--force]
                           Run kairo-cli on the PC as a short \Kairo\Run job. It reaches a named-pipe
                           server running outside \Kairo\Run: refused while a pc run job holds it.
  help                     This text.

Exit codes: 0 ok, 1 failed, 2 usage or bad input, 3 refused: PC busy, 4 refused: busy state unknown,
            5 job still running when the wait ended, 6 job stopped by kairo-devrun (time limit or
            owner input), 7 a display-driver reset or unexpected reboot during a harness run (P0),
            255 ssh could not connect.
Environment: KAIRO_PC (ssh alias, default kairo-pc), KAIRO_PC_KEY (default ~/.ssh/kairo_pc),
             KAIRO_PC_PWSH (PowerShell 7 on the PC, default
             C:\Program Files\PowerShell\7\pwsh.exe).
EOF
}

cmd_status() {
    local json=0
    while [ $# -gt 0 ]; do
        case "$1" in
        --json) json=1 ;;
        *) usage_error "status: unknown option $1" ;;
        esac
        shift
    done
    pre_reset
    pre_bool Json "$json"
    run_ps status
}

cmd_doctor() {
    local use_local=0 presentmon=0 compress=0 file encoded
    while [ $# -gt 0 ]; do
        case "$1" in
        --local) use_local=1 ;;
        --test-presentmon) presentmon=1 ;;
        --compress) compress=1 ;;
        *) usage_error "doctor: unknown option $1" ;;
        esac
        shift
    done
    pre_reset
    pre_bool TestPresentMon "$presentmon"
    pre_bool Compress "$compress"
    if [ "$use_local" = 1 ]; then
        file="$REPO_ROOT/tools/pc/doctor.ps1"
        [ -f "$file" ] || die "there is no $file on the Mac"
        encoded=$(/usr/bin/base64 <"$file" | tr -d '\n') || die "could not read $file"
        [ -n "$encoded" ] || die "$file is empty"
        pre_str LocalB64 "$encoded"
    fi
    run_ps run-doctor
}

# --- sync ---------------------------------------------------------------------------------
SNAP_SHA=''
SNAP_DESC=''

check_untracked_sizes() { # refuse to ship big untracked files by accident (clips, dumps, archives)
    local allow=$1 file size big=''
    while IFS= read -r -d '' file; do
        [ -f "$file" ] || continue
        size=$(stat -f %z "$file" 2>/dev/null) || continue
        if [ "$size" -gt "$MAX_UNTRACKED_BYTES" ]; then
            big="$big  $file ($((size / 1048576)) MiB)$NL"
        fi
    done < <(git ls-files --others --exclude-standard -z)
    [ -n "$big" ] || return 0
    if [ "$allow" = 1 ]; then
        err "sending large untracked files (--allow-large):$NL$big"
    else
        die "refusing to send untracked files over 50 MiB; add them to .gitignore or use --allow-large:$NL$big"
    fi
}

make_snapshot() {
    # A commit of index + working tree + untracked files that are not ignored, built in a copy of
    # the index. It is a loose object only: no branch, ref, index or stash entry changes.
    # Author and date are fixed, so an unchanged tree gives the same commit id every time.
    local tmp index real_index tree head date changed
    tmp=$(make_temp dir) || return 1
    register_temp "$tmp"
    index="$tmp/index"
    real_index=$(git rev-parse --git-path index) || return 1
    case "$real_index" in /*) ;; *) real_index="$REPO_ROOT/$real_index" ;; esac
    if [ -f "$real_index" ]; then
        cp "$real_index" "$index" || return 1
    fi
    GIT_INDEX_FILE="$index" git add -A -- . || return 1
    tree=$(GIT_INDEX_FILE="$index" git write-tree) || return 1
    if head=$(git rev-parse --verify -q 'HEAD^{commit}'); then
        if [ "$(git rev-parse "$head^{tree}")" = "$tree" ]; then
            SNAP_SHA=$head
            SNAP_DESC="HEAD $(git rev-parse --short=12 HEAD), no uncommitted changes"
            return 0
        fi
        date="$(git log -1 --format=%ct "$head") +0000"
        SNAP_SHA=$(GIT_AUTHOR_NAME='Kairo pc sync' GIT_AUTHOR_EMAIL='pc-sync@kairo.invalid' GIT_AUTHOR_DATE="$date" \
            GIT_COMMITTER_NAME='Kairo pc sync' GIT_COMMITTER_EMAIL='pc-sync@kairo.invalid' GIT_COMMITTER_DATE="$date" \
            git commit-tree --no-gpg-sign "$tree" -p "$head" -m "pc-sync snapshot: $head plus uncommitted changes") || return 1
        changed=$(git diff --name-only "$head" "$SNAP_SHA" | wc -l | tr -d ' ')
        SNAP_DESC="HEAD $(git rev-parse --short=12 HEAD) + $changed changed file(s)"
    else
        date='1700000000 +0000'
        SNAP_SHA=$(GIT_AUTHOR_NAME='Kairo pc sync' GIT_AUTHOR_EMAIL='pc-sync@kairo.invalid' GIT_AUTHOR_DATE="$date" \
            GIT_COMMITTER_NAME='Kairo pc sync' GIT_COMMITTER_EMAIL='pc-sync@kairo.invalid' GIT_COMMITTER_DATE="$date" \
            git commit-tree --no-gpg-sign "$tree" -m "pc-sync snapshot (no commits yet)") || return 1
        SNAP_DESC="no commits yet"
    fi
}

git_push_snapshot() {
    # updateInstead on the PC checks the pushed commit out, provided its working tree is clean.
    GIT_SSH_COMMAND="'$SELF'" GIT_SSH_VARIANT=simple KAIRO_PC_GIT_SSH=1 GIT_TERMINAL_PROMPT=0 \
        git push --no-verify --no-follow-tags --no-signed --no-recurse-submodules \
        "$PC_HOST:$PC_SRC_GIT" "+$1:refs/heads/snapshot"
}

send_bundle() { # send_bundle <sha> <PC head or empty>: git bundle + scp (the fallback)
    local sha=$1 pc_head=$2 tmp objects exclude=''
    tmp=$(make_temp dir) || return 1
    register_temp "$tmp"
    # A throwaway bare repository that borrows this repository's objects, so the bundle can
    # name the snapshot without creating any ref here.
    objects="$(cd "$(git rev-parse --git-common-dir)" && pwd -P)/objects" || return 1
    git init -q --bare --template= "$tmp/repo" || return 1
    printf '%s\n' "$objects" >"$tmp/repo/objects/info/alternates" || return 1
    git -C "$tmp/repo" update-ref refs/heads/snapshot "$sha" || return 1
    if [ -n "$pc_head" ] && git -C "$tmp/repo" cat-file -e "$pc_head^{commit}" 2>/dev/null; then
        exclude="^$pc_head"
    fi
    if [ -n "$exclude" ]; then
        git -C "$tmp/repo" bundle create -q "$tmp/kairo-sync.bundle" refs/heads/snapshot "$exclude" || return 1
    else
        git -C "$tmp/repo" bundle create -q "$tmp/kairo-sync.bundle" refs/heads/snapshot || return 1
    fi
    say "sending a git bundle ($(($(stat -f %z "$tmp/kairo-sync.bundle") / 1024)) KiB) with scp"
    ensure_agent_key
    "$SCP" "${SCP_OPTS[@]}" "$tmp/kairo-sync.bundle" "$PC_HOST:$PC_BUNDLE_SCP" || {
        err "scp of the bundle to $PC_HOST:$PC_BUNDLE_SCP failed"
        return 1
    }
}

cmd_sync() {
    local force=0 mode=auto allow_large=0 pc_head pc_branch pc_dirty pc_deny method='' short rc
    while [ $# -gt 0 ]; do
        case "$1" in
        --force) force=1 ;;
        --bundle) mode=bundle ;;
        --allow-large) allow_large=1 ;;
        *) usage_error "sync: unknown option $1" ;;
        esac
        shift
    done
    cd "$REPO_ROOT" || die "cannot enter $REPO_ROOT"
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$REPO_ROOT is not a git working tree"

    check_untracked_sizes "$allow_large"
    make_snapshot || die "could not build the snapshot commit"
    short=$(printf '%s' "$SNAP_SHA" | cut -c1-12)
    say "snapshot $short ($SNAP_DESC)"

    pre_reset
    pre_bool Force "$force"
    run_ps sync-pre
    rc=$?
    [ "$rc" = 0 ] || return "$rc"
    pc_head=$(kv_get head)
    pc_branch=$(kv_get branch)
    pc_dirty=$(kv_get dirty)
    pc_deny=$(kv_get deny)

    if [ "$pc_head" = "$SNAP_SHA" ] && [ "$pc_branch" = refs/heads/snapshot ] && [ "$pc_dirty" = 0 ]; then
        say "C:\\kairo\\src is already at $short on branch snapshot with a clean tree: nothing to send"
        return 0
    fi

    pre_reset
    pre_str Sha "$SNAP_SHA"
    if [ "$pc_head" = "$SNAP_SHA" ]; then
        say "the PC already has $short; resetting its working tree"
        method=reset
    else
        if [ "$mode" = auto ] && [ "$pc_dirty" = 1 ]; then
            say "C:\\kairo\\src has local changes, which updateInstead refuses to overwrite; using the bundle"
            mode=bundle
        fi
        if [ "$mode" = auto ] && [ "$pc_deny" != updateInstead ]; then
            say "C:\\kairo\\src does not have receive.denyCurrentBranch=updateInstead ('$pc_deny'); using the bundle"
            mode=bundle
        fi
        if [ "$mode" = auto ]; then
            if git_push_snapshot "$SNAP_SHA"; then
                method=push
            else
                err "git push to the PC failed; falling back to git bundle + scp"
            fi
        fi
        if [ -z "$method" ]; then
            send_bundle "$SNAP_SHA" "$pc_head" || die "the bundle fallback failed too"
            pre_str Bundle "$PC_BUNDLE_WIN"
            method=bundle
        fi
    fi
    run_ps sync-apply
    rc=$?
    [ "$rc" = 0 ] || return "$rc"
    say "synced $short to $PC_HOST:C:\\kairo\\src (branch snapshot) via $method"
}

# --- build, deploy, rollback --------------------------------------------------------------
cmd_build() {
    local force=0 tail='' packages=()
    while [ $# -gt 0 ]; do
        case "$1" in
        --force) force=1 ;;
        -p | --package)
            need_value "$1" $#
            is_package "$2" || usage_error "build: not a package name: $2"
            packages[${#packages[@]}]=$2
            shift
            ;;
        --tail)
            need_value "$1" $#
            is_uint "$2" || usage_error "build: --tail needs a number"
            tail=$2
            shift
            ;;
        *) usage_error "build: unknown option $1" ;;
        esac
        shift
    done
    pre_reset
    pre_bool Force "$force"
    [ -z "$tail" ] || pre_int Tail "$tail"
    pre_list Packages ${packages[@]+"${packages[@]}"}
    run_ps build
}

cmd_deploy() {
    local force=0
    while [ $# -gt 0 ]; do
        case "$1" in
        --force) force=1 ;;
        *) usage_error "deploy: unknown option $1" ;;
        esac
        shift
    done
    pre_reset
    pre_bool Force "$force"
    run_ps deploy
}

cmd_rollback() {
    local force=0 to=''
    while [ $# -gt 0 ]; do
        case "$1" in
        --force) force=1 ;;
        -*) usage_error "rollback: unknown option $1" ;;
        *)
            [ -z "$to" ] || usage_error "rollback: name at most one build"
            is_build_id "$1" || usage_error "rollback: not a build id (yyyyMMdd-HHmmss-<commit>): $1"
            to=$1
            ;;
        esac
        shift
    done
    pre_reset
    pre_bool Force "$force"
    [ -z "$to" ] || pre_str To "$to"
    run_ps rollback
}

# --- run ----------------------------------------------------------------------------------
JOB_ID=''
JOB_MAX=''

# Mirrors crates/kairo-core/src/job.rs, so a bad job fails here before anything is sent.
# shellcheck disable=SC2016 # a jq program: its $extra must not expand
JQ_JOB_CHECK='
def fail(m): error("job: " + m);
if type != "object" then fail("must be a JSON object") else . end
| (keys - ["id", "cmd", "cwd", "max_seconds", "abort_on_input", "window", "priority"]) as $extra
| if ($extra | length) > 0 then fail("unknown field(s) " + ($extra | join(", ")) + " (kairo-devrun rejects them)") else . end
| if (has("id") and has("cmd") and has("max_seconds")) | not then fail("id, cmd and max_seconds are required") else . end
| if (.id | type) != "string" or (.id | test("\\A[A-Za-z0-9_-]{1,64}\\z") | not) then fail("id must match ^[A-Za-z0-9_-]{1,64}$") else . end
| if (.cmd | type) != "array" or (.cmd | length) == 0 or ([.cmd[] | type] | unique) != ["string"] then fail("cmd must be a non-empty list of strings") else . end
| if .cmd[0] == "" then fail("cmd starts with an empty program") else . end
| if ([.cmd[] | explode | any(. < 32)] | any) then fail("cmd entries must not contain control characters") else . end
| if (.max_seconds | type) != "number" or .max_seconds != (.max_seconds | floor) or .max_seconds < 1 or .max_seconds > 86400 then fail("max_seconds must be a whole number from 1 to 86400") else . end
| if has("cwd") and .cwd != null and ((.cwd | type) != "string" or .cwd == "" or (.cwd | explode | any(. < 32))) then fail("cwd must be null or a folder") else . end
| if has("abort_on_input") and (.abort_on_input | type) != "boolean" then fail("abort_on_input must be true or false") else . end
| if has("window") and .window != "visible" and .window != "hidden" then fail("window must be \"visible\" or \"hidden\"") else . end
| if has("priority") and .priority != "normal" and .priority != "below_normal" then fail("priority must be \"normal\" or \"below_normal\"") else . end
| "\(.id) \(.max_seconds)"
'

resolve_job() { # a job file path, or a preset name from tools/mac/jobs
    if [ -f "$1" ]; then
        printf '%s\n' "$1"
        return 0
    fi
    if is_job_id "$1" && [ -f "$JOBS_DIR/$1.json" ]; then
        printf '%s\n' "$JOBS_DIR/$1.json"
        return 0
    fi
    local presets='' preset
    for preset in "$JOBS_DIR"/*.json; do
        [ -f "$preset" ] || continue
        preset=${preset##*/}
        presets="$presets${presets:+ }${preset%.json}"
    done
    err "run: no job file '$1' and no such preset (presets: ${presets:-none})"
    return 1
}

check_job_file() {
    local file=$1 size out
    size=$(stat -f %z "$file" 2>/dev/null) || die "cannot read $file"
    [ "$size" -le 65536 ] || die "the job file is larger than 64 KiB: $file" 2
    if [ ! -x /usr/bin/jq ]; then
        err "note: /usr/bin/jq is missing, so the job is only checked on the PC"
        JOB_ID='?'
        return 0
    fi
    out=$(/usr/bin/jq -r "$JQ_JOB_CHECK" "$file" 2>&1) || die "$(printf '%s' "$out" | sed 's/^jq: error (at [^)]*): //') ($file)" 2
    JOB_ID=${out%% *}
    JOB_MAX=${out#* }
    is_job_id "$JOB_ID" || die "job: bad id in $file" 2
}

cmd_run() {
    local force=0 wait='' no_wait=0 tail='' spec='' file encoded
    while [ $# -gt 0 ]; do
        case "$1" in
        --force) force=1 ;;
        --no-wait) no_wait=1 ;;
        --wait)
            need_value "$1" $#
            is_uint "$2" || usage_error "run: --wait needs a number of seconds"
            wait=$2
            shift
            ;;
        --tail)
            need_value "$1" $#
            is_uint "$2" || usage_error "run: --tail needs a number"
            tail=$2
            shift
            ;;
        -*) usage_error "run: unknown option $1" ;;
        *)
            [ -z "$spec" ] || usage_error "run: name one job"
            spec=$1
            ;;
        esac
        shift
    done
    [ -n "$spec" ] || usage_error "run: name a job file or a preset (e.g. hello)"
    file=$(resolve_job "$spec") || exit 2
    check_job_file "$file"
    encoded=$(/usr/bin/base64 <"$file" | tr -d '\n') || die "cannot read $file"
    pre_reset
    pre_bool Force "$force"
    pre_str JobB64 "$encoded"
    if [ "$no_wait" = 1 ]; then
        pre_int Wait 0
    elif [ -n "$wait" ]; then
        pre_int Wait "$wait"
    fi
    [ -z "$tail" ] || pre_int Tail "$tail"
    say "job $JOB_ID from ${file#"$REPO_ROOT"/}${JOB_MAX:+ (max_seconds $JOB_MAX)}"
    run_ps run
}

# --- harness -------------------------------------------------------------------------------
# research 16 README section 8.7. The job runs kairo-harness from the current build; it writes
# C:\kairo\logs\harness-displays.json, which comes back through the read-only
# remote/harness-fetch.ps1, and prints only a count, so no model name reaches this terminal.
HARNESS_DISPLAYS_FILE='harness-displays.json'
HARNESS_DISPLAYS_JOB='{"id":"harness-displays","cmd":["C:\\kairo\\bin\\current\\kairo-harness.exe","displays","--out","C:\\kairo\\logs\\harness-displays.json"],"cwd":null,"max_seconds":30,"abort_on_input":true,"window":"hidden"}'

# monitors.json from displays.json ($d, slurped), the old monitors.json ($m, or null) and the new aliases
# ($new, {"name": "DISPLAYn"}): every old alias stays (a display that is off or asleep may be
# missing from the list), and each new one is set by its GDI name now. A display that mirrors
# another (Duplicate mode) can't get one: a window meant for it would show on both.
# shellcheck disable=SC2016 # a jq program: its $d, $m, $new, $t, $e and $hits must not expand
JQ_MONITORS='
($d[0].targets) as $t
| reduce ($new | to_entries[]) as $e (($m.aliases // {});
    [$t[] | select(.gdi_name == ("\\\\.\\" + $e.value))] as $hits
    | if ($hits | length) == 0 then
        error("no active display " + $e.value + " (active: "
          + ([$t[].gdi_name | ltrimstr("\\\\.\\")] | if length == 0 then "none" else join(", ") end) + ")")
      elif ($hits | length) > 1 or ($hits[0].cloned // false) then
        error($e.value + " is mirrored on another display (Duplicate mode): switch Windows to Extend, then run again")
      elif $hits[0].device_path == "" then
        error($e.value + " is active, but Windows reported no device path for it, so it cannot have an alias")
      else . + {($e.key): $hits[0].device_path} end)
| {kairo_monitors: 1, aliases: .}
'

# The new aliases' DISPLAYn ($new) that name a display in the fetched list ($cur, slurped) other
# than the one in the table last shown ($prev, slurped), or one that table lacked: GDI numbers change across
# reboots and re-plugs. A DISPLAYn that isn't active now is JQ_MONITORS' to report.
# shellcheck disable=SC2016 # a jq program: its $prev, $cur and $new must not expand
JQ_STALE='
def path($doc; $g): [$doc.targets[] | select(.gdi_name == ("\\\\.\\" + $g)) | .device_path | ascii_downcase] | first;
$prev[0] as $prev | $cur[0] as $cur
| [$new[] | select(path($cur; .) != null and path($prev; .) != path($cur; .))] | unique | join(", ")
'

# Aliases that would name one display twice, e.g. "180hz and oled".
JQ_SHARED='[.aliases | to_entries | group_by(.value | ascii_downcase)[] | select(length > 1) | map(.key) | join(" and ")] | join("; ")'

# The aliases whose display isn't in the list now ($d, slurped).
# shellcheck disable=SC2016 # a jq program: its $d, $m and $t must not expand
JQ_ABSENT='
$d[0].targets as $t | ($m.aliases // {}) | to_entries[]
| select(.value as $p | $t | all(.device_path | ascii_downcase != ($p | ascii_downcase))) | .key
'

# One line per display ($d, slurped): GDI name, size, refresh, primary, HDR, mirroring and its
# aliases, with any control character from the PC turned into a space.
# shellcheck disable=SC2016 # a jq program: its $m, $a, $d and $t must not expand
JQ_DISPLAY_TABLE='
($m.aliases // {}) as $a
| $d[0].targets[]
| . as $t
| [ (.gdi_name | ltrimstr("\\\\.\\")),
    "\(.rect.right - .rect.left)x\(.rect.bottom - .rect.top)",
    (if .refresh.denominator > 0
     then "\((.refresh.numerator / .refresh.denominator * 100 | round) / 100) Hz" else "? Hz" end),
    (if .primary then "primary" else "-" end),
    (if .hdr.active then "HDR on" else "HDR off" end),
    (if .cloned // false then "mirrored" else "-" end),
    ([$a | to_entries[] | select(.value | ascii_downcase == ($t.device_path | ascii_downcase)) | .key]
     | if length == 0 then "-" else join(",") end) ]
| join("  ") | gsub("[[:cntrl:]]"; " ")
'

harness_displays() {
    local force=0 aliases='' arg name gdi encoded rc out dir displays monitors fetched new old merged
    local stale shared absent written
    while [ $# -gt 0 ]; do
        case "$1" in
        --force) force=1 ;;
        --alias)
            need_value "$1" $#
            arg=$2
            name=${arg%%=*}
            gdi=${arg#*=}
            [ "$name" != "$arg" ] || usage_error "harness displays: --alias takes NAME=DISPLAYn"
            is_alias "$name" || usage_error "harness displays: an alias matches ^[a-z0-9][a-z0-9_-]{0,31}\$: $name"
            case "$gdi" in
            DISPLAY[0-9] | DISPLAY[0-9][0-9]) ;;
            *) usage_error "harness displays: name the display by its GDI name now, DISPLAYn: $gdi" ;;
            esac
            aliases="$aliases$name=$gdi$NL"
            shift
            ;;
        *) usage_error "harness displays: unknown argument $1" ;;
        esac
        shift
    done
    [ -x /usr/bin/jq ] || die "harness displays needs /usr/bin/jq"
    # PC details: .dogfood/ only (CLAUDE.md), readable by this account alone.
    dir="$REPO_ROOT/.dogfood/pc"
    displays="$dir/displays.json"
    monitors="$dir/monitors.json"
    new=$(printf '%s' "$aliases" | /usr/bin/jq -R -s 'split("\n") | map(select(length > 0) | split("=") | {(.[0]): .[1]}) | add // {}') ||
        die "harness displays: bad --alias values"
    # An alias names a display from a table someone has read.
    if [ "$new" != '{}' ] && [ ! -f "$displays" ]; then
        die "harness displays: run it once without --alias and read its table first" 2
    fi
    encoded=$(printf '%s' "$HARNESS_DISPLAYS_JOB" | /usr/bin/base64 | tr -d '\n') || die "base64 failed"
    pre_reset
    pre_bool Force "$force"
    pre_str JobB64 "$encoded"
    say "job harness-displays (kairo-harness displays, max_seconds 30)"
    run_ps run
    rc=$?
    [ "$rc" = 0 ] || return "$rc"
    pre_reset
    pre_bool Force "$force"
    pre_str Id harness-displays
    pre_str File "$HARNESS_DISPLAYS_FILE"
    run_ps harness-fetch
    rc=$?
    [ "$rc" = 0 ] || return "$rc"
    out=$(kv_get out)
    [ -n "$out" ] || die "harness displays: the PC sent no file"
    (umask 077 && mkdir -p "$dir") || die "cannot create $dir"
    # Decoded beside its target, never in the shared temp folder, then moved into place whole.
    fetched=$(mktemp "$dir/.displays.json.XXXXXX") || die "mktemp failed"
    register_temp "$fetched"
    printf '%s' "$out" | /usr/bin/base64 -D >"$fetched" 2>/dev/null || die "harness displays: the file isn't Base64"
    /usr/bin/jq -e '.kairo_displays == 1 and (.targets | type) == "array"' "$fetched" >/dev/null 2>&1 ||
        die "harness displays: the file isn't displays.json version 1"
    [ "$(/usr/bin/jq '.targets | length' "$fetched")" -gt 0 ] ||
        die "harness displays: the PC reports no active display (screens off or asleep?); the old files stay"
    if [ "$new" != '{}' ]; then
        stale=$(/usr/bin/jq -r -n --slurpfile prev "$displays" --slurpfile cur "$fetched" --argjson new "$new" "$JQ_STALE") ||
            die "harness displays: cannot compare the tables"
        [ -z "$stale" ] ||
            die "harness displays: $stale names another display than in the last table; run it without --alias, read the table and run again" 2
    fi
    mv -f "$fetched" "$displays" || die "cannot write $displays"
    old=null
    [ ! -f "$monitors" ] || old=$(cat "$monitors")
    if ! merged=$(/usr/bin/jq -n --slurpfile d "$displays" --argjson m "$old" --argjson new "$new" "$JQ_MONITORS" 2>&1); then
        say "kept ${displays#"$REPO_ROOT"/}; ${monitors#"$REPO_ROOT"/} is unchanged:"
        /usr/bin/jq -r -n --slurpfile d "$displays" --argjson m "$old" "$JQ_DISPLAY_TABLE" | sed 's/^/  /'
        die "harness displays: $(printf '%s' "$merged" | sed 's/^jq: error[^:]*: //')"
    fi
    shared=$(printf '%s' "$merged" | /usr/bin/jq -r "$JQ_SHARED") || die "harness displays: cannot read the aliases"
    [ -z "$shared" ] || die "harness displays: $shared would name the same display; ${monitors#"$REPO_ROOT"/} is unchanged" 2
    written=$(mktemp "$dir/.monitors.json.XXXXXX") || die "mktemp failed"
    register_temp "$written"
    printf '%s\n' "$merged" >"$written" || die "cannot write $monitors"
    mv -f "$written" "$monitors" || die "cannot write $monitors"
    say "kept ${displays#"$REPO_ROOT"/} and ${monitors#"$REPO_ROOT"/}:"
    /usr/bin/jq -r -n --slurpfile d "$displays" --argjson m "$merged" "$JQ_DISPLAY_TABLE" | sed 's/^/  /'
    absent=$(/usr/bin/jq -r -n --slurpfile d "$displays" --argjson m "$merged" "$JQ_ABSENT" | tr '\n' ' ')
    [ -z "$absent" ] || say "not active now, kept: ${absent% }"
    if [ "$(printf '%s' "$merged" | /usr/bin/jq '.aliases | length')" = 0 ]; then
        say "no aliases yet: run again with --alias 180hz=DISPLAYn (and --alias oled=DISPLAYm)"
    fi
    return 0
}

# --- harness capture -----------------------------------------------------------------------
# Gate 2 (research 16 README section 8.7): one hidden job runs "kairo-harness run", which starts
# the testbed on the monitor, records it with FFmpeg into AMF and has kairo-verify judge the clip.
# The job and everything fetched stay in .dogfood/ (they name a monitor and the PC's adapter);
# this terminal gets the verdict, the failing checks, counts and file names only. Afterwards the
# System log is read for display-driver resets (4101) and unexpected reboots (41): either is a
# P0 (M1:204), exit 7, and the next capture refuses to start until the check has run.

# The device path of alias $a in monitors.json, refusing the OLED: its alias, or any alias that
# names the same display. Without an oled alias the guard would be blind, so that refuses too.
# shellcheck disable=SC2016 # a jq program: its $a must not expand
JQ_CAPTURE_MONITOR='
if .kairo_monitors != 1 then error("monitors.json is not version 1")
elif $a == "oled" then error("the OLED shows moving content only, never a capture (M1:43)")
elif (.aliases.oled // null) == null then error("monitors.json has no oled alias: set it with pc harness displays --alias oled=DISPLAYn, so a capture can never land on the OLED")
elif (.aliases[$a] // null) == null then error("monitors.json has no alias " + $a)
elif (.aliases[$a] | ascii_downcase) == (.aliases.oled | ascii_downcase) then error($a + " names the same display as oled")
else .aliases[$a] end
'

# The report, for this terminal: no adapter, LUID, device path or FFmpeg build name.
# shellcheck disable=SC2016 # a jq program
JQ_HARNESS_SUMMARY='
"harness: exit \(.exit_code) (\(.reason))",
(.phases[] | "  \(.name)\t\(.seconds) s\t\(.outcome)"),
"read-back: \(.readback_counts.verified) verified, \(.readback_counts.failed) failed, \(.readback_counts.unknown) unknown, \(.readback_counts.not_read_back) set but not read back",
(if .adapter.match == false then "adapter: FFmpeg opened another adapter than the monitor'"'"'s" else empty end),
(if .ffmpeg.border_warning then "note: Windows didn'"'"'t let FFmpeg hide the capture border (the borderless-capture permission)" else empty end)
| gsub("[[:cntrl:]]"; " ")
'

# kairo-verify's failing checks, one line each.
JQ_VERIFY_FAILING='.checks[] | select(.status == "fail" or .status == "error") | "\(.id): \(.detail)" | gsub("[[:cntrl:]]"; " ")'

# The pending reset checks of earlier captures: a capture whose check didn't finish blocks the next.
harness_pending_checks() {
    local marker stamp since rc
    for marker in "$REPO_ROOT"/.dogfood/harness/*/tdr-pending; do
        [ -f "$marker" ] || continue
        stamp=${marker%/tdr-pending}
        stamp=${stamp##*/}
        since=$(head -n 1 "$marker")
        say "checking the System log after harness-$stamp, whose check didn't finish"
        pre_reset
        pre_str Id "harness-$stamp"
        pre_str Since "$since"
        run_ps harness-events
        rc=$?
        case "$rc" in
        0) rm -f "$marker" ;;
        7)
            err "P0: a display-driver reset or an unexpected reboot during harness-$stamp: stop all PC work and report it to the owner"
            exit 7
            ;;
        *) die "the reset check of harness-$stamp is still pending (exit $rc); nothing started" 1 ;;
        esac
    done
}

harness_events() {
    [ $# -eq 0 ] || usage_error "harness events: takes no arguments"
    local before
    before=$(find "$REPO_ROOT/.dogfood/harness" -name tdr-pending 2>/dev/null | wc -l | tr -d ' ')
    harness_pending_checks
    [ "$before" != 0 ] || say "no pending reset checks"
    return 0
}

harness_capture() {
    local force=0 alias=180hz seconds='' smoke=0 fps=180 capture=gfxcapture rate='' output=1080p60
    local loglevel=debug finishing=0 voice=0 fetch_clip=0 profile size path stamp id dir job_tmp
    local encoded started final run_rc events_rc verdict share asset pinned bytes need free
    local rate_on finishing_on voice_on
    local start=$SECONDS
    while [ $# -gt 0 ]; do
        case "$1" in
        --force) force=1 ;;
        --smoke) smoke=1 ;;
        --finishing) finishing=1 ;;
        --voice) voice=1 ;;
        --fetch-clip) fetch_clip=1 ;;
        --monitor)
            need_value "$1" $#
            is_alias "$2" || usage_error "harness capture: --monitor takes an alias from monitors.json"
            alias=$2
            shift
            ;;
        --seconds)
            need_value "$1" $#
            if ! is_uint "$2" || [ "$2" -lt 5 ] || [ "$2" -gt 60 ]; then
                usage_error "harness capture: --seconds takes 5 to 60"
            fi
            seconds=$2
            shift
            ;;
        --testbed-fps)
            need_value "$1" $#
            if ! is_uint "$2" || [ "$2" -lt 1 ] || [ "$2" -gt 1000 ]; then
                usage_error "harness capture: --testbed-fps takes 1 to 1000"
            fi
            fps=$2
            shift
            ;;
        --mode)
            need_value "$1" $#
            [ "$2" = borderless ] || usage_error "harness capture: only --mode borderless runs in this version (exclusive needs minutes of foreground wait; a windowed capture of the frame is unverified)"
            shift
            ;;
        --capture)
            need_value "$1" $#
            case "$2" in gfxcapture | ddagrab) capture=$2 ;; *) usage_error "harness capture: --capture takes gfxcapture or ddagrab" ;; esac
            shift
            ;;
        --capture-rate)
            need_value "$1" $#
            [ "$2" = 90 ] || usage_error "harness capture: --capture-rate takes 90"
            rate=90
            shift
            ;;
        --output)
            need_value "$1" $#
            case "$2" in 1080p60 | 1440p60) output=$2 ;; *) usage_error "harness capture: --output takes 1080p60 or 1440p60" ;; esac
            shift
            ;;
        --loglevel)
            need_value "$1" $#
            case "$2" in debug | verbose) loglevel=$2 ;; *) usage_error "harness capture: --loglevel takes debug or verbose" ;; esac
            shift
            ;;
        *) usage_error "harness capture: unknown argument $1" ;;
        esac
        shift
    done
    if [ "$smoke" = 1 ]; then
        [ -z "$seconds" ] || usage_error "harness capture: --smoke is 10 s; leave out --seconds"
        [ -z "$rate" ] || usage_error "harness capture: --capture-rate isn't for --smoke"
        seconds=10
        profile=smoke
    else
        seconds=${seconds:-30}
        profile=capture
    fi
    [ -z "$rate" ] || [ "$capture" = gfxcapture ] || usage_error "harness capture: --capture-rate is gfxcapture's: not with ddagrab"
    [ -x /usr/bin/jq ] || die "harness capture needs /usr/bin/jq"
    case "$output" in 1080p60) size=1920x1080@60 ;; *) size=2560x1440@60 ;; esac

    harness_pending_checks

    # The monitor, never the OLED; the path stays in .dogfood/.
    [ -f "$REPO_ROOT/.dogfood/pc/monitors.json" ] ||
        die "harness capture: run pc harness displays, then --alias 180hz=DISPLAYn --alias oled=DISPLAYm" 2
    path=$(/usr/bin/jq -r --arg a "$alias" "$JQ_CAPTURE_MONITOR" "$REPO_ROOT/.dogfood/pc/monitors.json" 2>&1) ||
        die "harness capture: $(printf '%s' "$path" | sed 's/^jq: error[^:]*: //')" 2
    case "$path" in "\\\\?\\"*) ;; *) die "harness capture: the alias $alias doesn't hold a device path" 2 ;; esac
    case "$path" in *[![:print:]]*) die "harness capture: the alias $alias holds a control character" 2 ;; esac

    stamp=$(date -u +%Y%m%d-%H%M%S)
    id="harness-$stamp"
    dir="$REPO_ROOT/.dogfood/harness/$stamp"
    if [ -e "$REPO_ROOT/.dogfood/jobs/$id.json" ] || [ -e "$dir" ]; then
        die "harness capture: $id exists already; try again in a second"
    fi
    (umask 077 && mkdir -p "$REPO_ROOT/.dogfood/jobs" "$dir") || die "cannot create .dogfood/harness/$stamp"
    job_tmp=$(mktemp "$REPO_ROOT/.dogfood/jobs/.$id.json.XXXXXX") || die "mktemp failed"
    register_temp "$job_tmp"
    rate_on=false
    [ -z "$rate" ] || rate_on=true
    finishing_on=false
    [ "$finishing" = 0 ] || finishing_on=true
    voice_on=false
    [ "$voice" = 0 ] || voice_on=true
    /usr/bin/jq -n --arg id "$id" --arg path "$path" --arg fps "$fps" --arg size "$size" --arg s "$seconds" \
        --arg profile "$profile" --arg capture "$capture" --arg loglevel "$loglevel" \
        --argjson max "$((seconds + 210))" --argjson rate "$rate_on" \
        --argjson finishing "$finishing_on" --argjson voice "$voice_on" \
        '{id: $id,
          cmd: (["C:\\kairo\\bin\\current\\kairo-harness.exe", "run", "--run-id", $id, "--monitor", $path,
                 "--testbed-fps", $fps, "--mode", "borderless", "--output", $size, "--seconds", $s,
                 "--profile", $profile, "--capture", $capture, "--loglevel", $loglevel]
                + (if $rate then ["--capture-rate", "90"] else [] end)
                + (if $finishing then ["--finishing", "h264_metadata"] else [] end)
                + (if $voice then ["--voice"] else [] end)),
          cwd: "C:\\kairo\\logs", max_seconds: $max, abort_on_input: true, window: "hidden"}' >"$job_tmp" ||
        die "harness capture: cannot write the job"
    mv -f "$job_tmp" "$REPO_ROOT/.dogfood/jobs/$id.json" || die "harness capture: cannot write the job"
    check_job_file "$REPO_ROOT/.dogfood/jobs/$id.json"

    # Read-only notes first: Instant Replay's registry hints and the FFmpeg build. Never refuses.
    pre_reset
    run_ps harness-pre >/dev/null
    /usr/bin/jq -n --arg r "$(kv_get ir_replay)" --arg d "$(kv_get ir_dvr)" --arg a "$(kv_get ffmpeg_asset)" \
        '{ir_replay: $r, ir_dvr: $d, ffmpeg_asset: $a}' >"$dir/pre.json" || die "cannot write $dir/pre.json"

    encoded=$(/usr/bin/base64 <"$REPO_ROOT/.dogfood/jobs/$id.json" | tr -d '\n') || die "base64 failed"
    pre_reset
    pre_bool Force "$force"
    pre_str JobB64 "$encoded"
    pre_bool FullscreenRefuses 1
    pre_int Wait "$((seconds + 240))"
    pre_int Tail 40
    say "job $id ($profile, $seconds s, monitor $alias, $capture, $output, max_seconds $((seconds + 210)))"
    run_ps run
    run_rc=$?
    started=$(kv_get started)
    # Nothing started: nothing to check or fetch.
    [ -n "$started" ] || return "$run_rc"

    printf '%s\n' "$started" >"$dir/tdr-pending"
    pre_reset
    pre_str Id "$id"
    pre_str Since "$started"
    run_ps harness-events
    events_rc=$?
    final=$run_rc
    case "$events_rc" in
    0) rm -f "$dir/tdr-pending" ;;
    7)
        err "P0: a display-driver reset or an unexpected reboot during $id: stop all PC work and report it to the owner (read-only follow-up: pc logs $id)"
        exit 7
        ;;
    *) [ "$final" -ne 0 ] || final=1 ;;
    esac
    case "$run_rc" in 0 | 1) ;; *) return "$run_rc" ;; esac

    pre_reset
    pre_bool Force "$force"
    pre_str Id "$id"
    pre_list Files harness.json verify.json verify.txt
    run_ps harness-fetch >/dev/null || {
        err "harness capture: the reports couldn't be fetched"
        return 1
    }
    harness_keep "$dir" harness_json harness.json '.kairo_harness == 1'
    harness_keep "$dir" verify_json verify.json '.kairo_verify == 1'
    harness_keep "$dir" verify_txt verify.txt ''

    if [ -f "$dir/harness.json" ]; then
        /usr/bin/jq -r "$JQ_HARNESS_SUMMARY" "$dir/harness.json"
    else
        say "no harness.json: the harness didn't finish (job exit $(kv_get result_exit), $(kv_get result_reason))"
        [ "$final" -ne 0 ] || final=1
    fi
    verdict=''
    if [ -f "$dir/verify.json" ]; then
        verdict=$(/usr/bin/jq -r '.verdict' "$dir/verify.json")
        say "verify: $verdict"
        /usr/bin/jq -r "$JQ_VERIFY_FAILING" "$dir/verify.json" | sed 's/^/  failing: /'
        share=$(/usr/bin/jq -r '[.checks[] | select(.id == "content.barcode") | .value.share // empty][0] // empty' "$dir/verify.json")
        [ -z "$share" ] || say "barcodes read: $(/usr/bin/jq -n --argjson s "$share" '$s * 10000 | round / 100')% (research 16 section 4.12: 99.9%)"
    fi
    [ ! -f "$dir/verify.txt" ] || sed 's/[[:cntrl:]]/ /g; s/^/  /' "$dir/verify.txt"
    say "Instant Replay (registry hints, read only): $(/usr/bin/jq -r '"InstantReplayEnabled \(.ir_replay), DvrEnabled \(.ir_dvr)"' "$dir/pre.json"); encoder use: not measured yet (PR 9c)"
    [ "$events_rc" != 0 ] || say "System events 4101 and 41 since the job started: none"
    asset=$(/usr/bin/jq -r '.ffmpeg_asset' "$dir/pre.json")
    pinned=$(sed -n "s/^\$FfmpegAsset *= *'\([^']*\)'.*/\1/p" "$REPO_ROOT/tools/pc/bootstrap.ps1" | head -n 1)
    case "$asset" in
    "$pinned".zip | "$pinned") ;;
    *) say "warning: the PC's FFmpeg isn't the pinned build (M1:163): this run doesn't count for gate 2" ;;
    esac
    say "kept in .dogfood/harness/$stamp/"
    say "start -> report: $((SECONDS - start)) s (gate 2: under 300 s)"

    # Exit: the harness's own non-zero codes all become 1; for pc, 3, 4 and 5 mean other things.
    if [ "$final" = 0 ] && [ -f "$dir/harness.json" ] && [ "$(/usr/bin/jq -r '.exit_code' "$dir/harness.json")" != 0 ]; then
        final=1
    fi
    if [ "$final" = 0 ] && [ "$smoke" = 1 ] && [ "$verdict" != pass ]; then
        final=1
    fi

    if [ "$fetch_clip" = 1 ]; then
        bytes=$(/usr/bin/jq -r '.ffmpeg.bytes // 0' "$dir/harness.json" 2>/dev/null)
        case "$bytes" in '' | *[!0-9]*) bytes=0 ;; esac
        if [ "$bytes" -eq 0 ] || [ "$bytes" -gt $((512 * 1048576)) ]; then
            err "harness capture: no clip to fetch, or larger than 512 MiB"
            return 1
        fi
        # The Base64 and the clip both pass through the disk: 2.5 times the clip and 1 GiB more.
        need=$(((bytes * 5 / 2) / 1024 + 1048576))
        for free in "$(df -k "$TMP_BASE" | awk 'NR == 2 { print $4 }')" "$(df -k "$REPO_ROOT" | awk 'NR == 2 { print $4 }')"; do
            [ "$free" -ge "$need" ] || die "harness capture: not enough free disk for the clip (need $need KiB)"
        done
        pre_reset
        pre_bool Force "$force"
        pre_str Id "$id"
        pre_bool Clip 1
        run_ps harness-fetch >/dev/null || {
            err "harness capture: the clip couldn't be fetched"
            return 1
        }
        harness_keep_clip "$dir" || return 1
    fi
    return "$final"
}

# Decodes the fetched Base64 key $2 into $1/$3, checked with jq program $4 (none for text).
harness_keep() {
    local dir=$1 key=$2 name=$3 check=$4 value tmp
    value=$(kv_get "$key")
    [ -n "$value" ] || return 0
    tmp=$(mktemp "$dir/.$name.XXXXXX") || die "mktemp failed"
    register_temp "$tmp"
    printf '%s' "$value" | /usr/bin/base64 -D >"$tmp" 2>/dev/null || die "harness capture: $name isn't Base64"
    if [ -n "$check" ]; then
        /usr/bin/jq -e "$check" "$tmp" >/dev/null 2>&1 || die "harness capture: $name isn't the expected report"
    fi
    mv -f "$tmp" "$dir/$name" || die "cannot write $dir/$name"
}

harness_keep_clip() {
    local dir=$1 tmp sum want
    tmp=$(mktemp "$dir/.capture.mp4.XXXXXX") || die "mktemp failed"
    register_temp "$tmp"
    sed -n 's/^clip=//p' "$KV_FILE" | /usr/bin/base64 -D >"$tmp" 2>/dev/null || die "harness capture: the clip isn't Base64"
    want=$(kv_get clip_sha256)
    sum=$(/usr/bin/shasum -a 256 "$tmp" | awk '{ print $1 }')
    if [ -z "$want" ] || [ "$sum" != "$want" ]; then
        die "harness capture: the clip's SHA-256 doesn't match the PC's"
    fi
    mv -f "$tmp" "$dir/capture.mp4" || die "cannot write $dir/capture.mp4"
    say "fetched the clip into .dogfood/harness/${dir##*/}/capture.mp4 ($(kv_get clip_bytes) bytes)"
}

cmd_harness() {
    [ $# -gt 0 ] || usage_error "harness: name a verb (this version has: displays, capture, events)"
    local verb=$1
    shift
    case "$verb" in
    displays) harness_displays "$@" ;;
    capture) harness_capture "$@" ;;
    events) harness_events "$@" ;;
    *) usage_error "harness: unknown verb $verb (this version has: displays, capture, events)" ;;
    esac
}

# --- logs, cli, ssh ------------------------------------------------------------------------
cmd_logs() {
    local force=0 tail='' id=''
    while [ $# -gt 0 ]; do
        case "$1" in
        --force) force=1 ;;
        --tail)
            need_value "$1" $#
            is_uint "$2" || usage_error "logs: --tail needs a number"
            tail=$2
            shift
            ;;
        -*) usage_error "logs: unknown option $1" ;;
        *)
            [ -z "$id" ] || usage_error "logs: name one id"
            is_job_id "$1" || usage_error "logs: an id matches ^[A-Za-z0-9_-]{1,64}$: $1"
            id=$1
            ;;
        esac
        shift
    done
    pre_reset
    pre_bool Force "$force"
    [ -z "$id" ] || pre_str Id "$id"
    [ -z "$tail" ] || pre_int Tail "$tail"
    run_ps logs
}

cmd_cli() {
    local force=0 sub='' pipe=''
    while [ $# -gt 0 ]; do
        case "$1" in
        --force) force=1 ;;
        --pipe)
            need_value "$1" $#
            is_pipe_name "$2" || usage_error "cli: not a pipe name: $2"
            pipe=$2
            shift
            ;;
        ping | keys)
            [ -z "$sub" ] || usage_error "cli: name one command"
            sub=$1
            ;;
        *) usage_error "cli: unknown argument $1 (use ping or keys)" ;;
        esac
        shift
    done
    [ -n "$sub" ] || usage_error "cli: name a command: ping or keys"
    pre_reset
    pre_bool Force "$force"
    if [ -n "$pipe" ]; then
        pre_list CliArgs "$sub" --pipe "$pipe"
    else
        pre_list CliArgs "$sub"
    fi
    run_ps cli
}

cmd_ssh() {
    # Gone: the SSH session is elevated, and an interactive shell would start in the owner's home
    # folder, run any program found there before PATH, and load the owner's PowerShell profile and
    # modules with administrator rights (docs/milestones/M1.md, open items).
    err "there is no interactive shell on the PC: an elevated shell would run programs from the owner's folders with administrator rights. Use the verbs (pc help)."
    exit 2
}

# ------------------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------------------
if [ "${KAIRO_PC_GIT_SSH:-}" = 1 ]; then
    git_ssh_transport "$@"
    exit $?
fi

[ $# -gt 0 ] || {
    usage
    exit 2
}
verb=$1
shift
case "$verb" in
status) cmd_status "$@" ;;
doctor) cmd_doctor "$@" ;;
sync) cmd_sync "$@" ;;
build) cmd_build "$@" ;;
deploy) cmd_deploy "$@" ;;
rollback) cmd_rollback "$@" ;;
run) cmd_run "$@" ;;
logs) cmd_logs "$@" ;;
harness) cmd_harness "$@" ;;
cli) cmd_cli "$@" ;;
ssh) cmd_ssh "$@" ;;
help | -h | --help) usage ;;
*) usage_error "unknown verb: $verb" ;;
esac
exit $?
